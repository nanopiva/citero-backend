# CONCURRENCY_AVAILABILITY_MAX=20
# CONCURRENCY_BOOKING_MAX=10
# CITERO_EMAIL_RETRY_MAX_ATTEMPTS=3
# CITERO_EMAIL_RETRY_BACKOFF_MS=1000
# CITERO_REMINDER_SCHEDULER_ENABLED=true
# MULTIPART_MAX_FILE_SIZE=2MB
# MULTIPART_MAX_REQUEST_SIZE=3MB
