# Backend de Citero — variables de entorno.
# Local:            cp .env.example .env
# Producción:       se cargan como secretos en la plataforma (Fly.io).

# Perfil de Spring: dev (H2 en memoria) o prod (PostgreSQL).
SPRING_PROFILES_ACTIVE=dev

# Base de datos (en dev se ignora, usa H2). En prod, usar la URL de Neon con sslmode=require.
DB_URL=jdbc:postgresql://localhost:5432/citero
DB_USERNAME=citero
DB_PASSWORD=citero
DB_DRIVER=org.postgresql.Driver

# Password del contenedor Postgres de docker-compose (solo dev).
POSTGRES_PASSWORD=

# Firma de los access tokens. Obligatorio: Base64 de >= 64 bytes (openssl rand -base64 64).
CITERO_JWT_SECRET=

# Opcionales: si quedan vacíos, OTP y links públicos reutilizan el secreto del JWT.
CITERO_OTP_SECRET=
CITERO_PUBLIC_LINK_SECRET=

# CORS: orígenes exactos separados por coma. Obligatorio (sin esto la app no arranca).
CITERO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# URLs del frontend, usadas en los links de los emails.
CITERO_FRONTEND_URL=http://localhost:3000
CITERO_FRONTEND_DASHBOARD_URL=http://localhost:3000/dashboard

# Cookie del refresh token. En producción: CITERO_COOKIE_SECURE=true.
CITERO_COOKIE_SECURE=false
CITERO_COOKIE_SAME_SITE=Lax
# CITERO_COOKIE_NAME=citero_refresh
# CITERO_COOKIE_DOMAIN=.citero.app
# CITERO_COOKIE_PATH=/api/auth

# Email (Resend). En dev puede ir "dev-dummy" para no enviar.
RESEND_API_KEY=
CITERO_EMAIL_FROM=noreply@citero.app

# Imágenes (Cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=citero

# --- Opcionales (tienen valores por defecto) ---
# PORT=8080
# CITERO_JWT_ISSUER=citero
# CITERO_JWT_AUDIENCE=citero-app
# CITERO_ACCESS_TOKEN_TTL_MS=900000
# CITERO_REFRESH_TOKEN_TTL_MS=2592000000
# CITERO_LOGIN_LOCKOUT_MAX_FAILURES=5
# CITERO_LOGIN_LOCKOUT_FAILURE_WINDOW_MINUTES=15
# CITERO_LOGIN_LOCKOUT_LOCK_MINUTES=15
# CITERO_MFA_ISSUER=Citero
# CITERO_MFA_DIGITS=6
# CITERO_MFA_CHALLENGE_TTL_MS=300000
# CITERO_PUBLIC_LINK_GRACE_HOURS=720
# CITERO_OTP_LOG_CODE=false
# HIBP_ENABLED=true
# CITERO_RATE_LIMIT_TRUSTED_PROXY_HOPS=1
# RATE_LIMIT_AVAILABILITY_GLOBAL_PER_MIN=1200
