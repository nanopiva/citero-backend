# =============================================================================
# Plantilla de variables de entorno del backend (Citero)
# Copiá este archivo a .env y completá los valores.
#   cp .env.example .env
# El archivo .env NO se versiona y es SOLO para desarrollo local.
#
# En PRODUCCIÓN no se usa .env: las variables se definen en la plataforma
# (Railway/Heroku) o en el sistema operativo. Mínimo requerido en prod:
#   DB_URL, DB_USERNAME, DB_PASSWORD, DB_DRIVER
#   CITERO_JWT_SECRET
#   RESEND_API_KEY, CITERO_EMAIL_FROM
#   CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
#   CITERO_FRONTEND_URL, CITERO_FRONTEND_DASHBOARD_URL
#   CITERO_CORS_ALLOWED_ORIGINS   (ej. https://citero.app)
#   CITERO_COOKIE_SECURE=true      (forzado por el perfil prod)
# =============================================================================

# --- Perfil de Spring ---
# Local: perfil dev (H2 en memoria + consola H2). Exportalo como variable de entorno
# del sistema (desde .env puede no activarse a tiempo):
#   SPRING_PROFILES_ACTIVE=dev
# En producción: SPRING_PROFILES_ACTIVE=prod
# SPRING_PROFILES_ACTIVE=dev

# --- Servidor ---
# Puerto HTTP. Si no se define, usa 8080 (Railway/Heroku suelen inyectar PORT).
# PORT=8080

# --- Base de datos (PostgreSQL; el perfil dev usa H2 y las ignora) ---
DB_URL=jdbc:postgresql://localhost:5432/citero
DB_USERNAME=citero
DB_PASSWORD=citero
DB_DRIVER=org.postgresql.Driver

# Password del contenedor Postgres de docker-compose (dev). Requerido: docker-compose
# no arranca si falta. No usar valores por defecto en producción.
POSTGRES_PASSWORD=

# --- JPA / Hibernate ---
# El esquema lo gestiona Flyway (src/main/resources/db/migration); ddl-auto en validate.
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false
# JPA_FORMAT_SQL=false
# JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
# HIBERNATE_SQL_LOG=WARN
# HIBERNATE_BINDER_LOG=WARN

# --- JWT ---
# OBLIGATORIO en todos los perfiles (incluido dev): si falta, la app no arranca.
# Generá un secreto largo y aleatorio en Base64 (al menos 64 bytes al decodificar).
#   ej.: openssl rand -base64 64
CITERO_JWT_SECRET=
# Emisor y audiencia de los access tokens (opcionales; estos son los defaults).
# CITERO_JWT_ISSUER=citero
# CITERO_JWT_AUDIENCE=citero-app
# Vida de los tokens en ms. Access: 15 min. Refresh: 30 días.
# CITERO_ACCESS_TOKEN_TTL_MS=900000
# CITERO_REFRESH_TOKEN_TTL_MS=2592000000

# --- Links públicos de gestión de turnos ---
# Secreto dedicado (Base64) para firmar los tokens del link "Gestionar mi turno".
# Si se deja vacío, se reutiliza CITERO_JWT_SECRET (no hace falta configurarlo).
# CITERO_PUBLIC_LINK_SECRET=
# Horas de validez del link contadas desde la hora de inicio del turno (default 720 = 30 días).
# CITERO_PUBLIC_LINK_GRACE_HOURS=720

# --- Cookie del refresh token ---
# En producción debe ser true (default). En local por HTTP, false.
CITERO_COOKIE_SECURE=false
# CITERO_COOKIE_NAME=citero_refresh
# SameSite de la cookie. Lax (default) o Strict alcanzan para misma-site (citero.app /
# api.citero.app). Si el front y la API están en dominios distintos, se necesita None,
# que OBLIGA a CITERO_COOKIE_SECURE=true; la protección CSRF la aporta la validación de
# Origin/Referer contra CITERO_CORS_ALLOWED_ORIGINS.
# CITERO_COOKIE_SAME_SITE=Lax
# CITERO_COOKIE_DOMAIN=.citero.app
# CITERO_COOKIE_PATH=/api/auth

# --- Frontend / CORS ---
CITERO_FRONTEND_URL=http://localhost:3000
CITERO_FRONTEND_DASHBOARD_URL=http://localhost:3000/dashboard
CITERO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting ---
# Proxies de confianza delante de la app (para resolver la IP real desde X-Forwarded-For).
# 1 = un único edge/proxy (Railway/Heroku). 0 = no confiar en XFF.
# CITERO_RATE_LIMIT_TRUSTED_PROXY_HOPS=1
# Store de contadores. "memory" sirve para una sola instancia. Con varias instancias o
# serverless, usar un store compartido (Redis) para que el límite sea global.
# CITERO_RATE_LIMIT_STORE=memory

# --- Resend (envío de emails) ---
# API key de Resend (https://resend.com/api-keys).
RESEND_API_KEY=
# Dirección verificada en Resend; debe pertenecer al dominio verificado.
CITERO_EMAIL_FROM=noreply@citero.app
# Reintentos de envío ante fallos.
# CITERO_EMAIL_RETRY_MAX_ATTEMPTS=3
# CITERO_EMAIL_RETRY_BACKOFF_MS=1000
# Habilita/deshabilita globalmente el scheduler de recordatorios.
# CITERO_REMINDER_SCHEDULER_ENABLED=true

# --- Cloudinary (subida de imágenes) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=citero

# --- Subida de archivos (multipart) ---
# MULTIPART_MAX_FILE_SIZE=5MB
# MULTIPART_MAX_REQUEST_SIZE=5MB
