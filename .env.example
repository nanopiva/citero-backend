# =============================================================================
# Plantilla de variables de entorno del backend (Citero)
# Copiá este archivo a .env y completá los valores.
#   cp .env.example .env
# El archivo .env NO se versiona.
# =============================================================================

# --- Perfil de Spring ---
# Local: perfil dev (H2 en memoria + consola H2). Exportalo como variable de entorno
# del sistema (desde .env puede no activarse a tiempo):
#   SPRING_PROFILES_ACTIVE=dev
# En producción: SPRING_PROFILES_ACTIVE=prod
# SPRING_PROFILES_ACTIVE=dev

# --- Servidor ---
# Puerto HTTP. Si no se define, usa 8080 (Railway/Heroku suelen inyectar PORT).
# PORT=8080

# --- Base de datos (PostgreSQL; el perfil dev usa H2 y las ignora) ---
DB_URL=jdbc:postgresql://localhost:5432/citero
DB_USERNAME=citero
DB_PASSWORD=citero
DB_DRIVER=org.postgresql.Driver

# --- JPA / Hibernate ---
# El esquema lo gestiona Flyway (src/main/resources/db/migration); ddl-auto en validate.
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false
# JPA_FORMAT_SQL=false
# JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
# HIBERNATE_SQL_LOG=WARN
# HIBERNATE_BINDER_LOG=WARN

# --- JWT ---
# Generá un secreto largo y aleatorio (Base64; al menos 64 bytes al decodificar).
CITERO_JWT_SECRET=
# Vida de los tokens en ms. Access: 15 min. Refresh: 30 días.
# CITERO_ACCESS_TOKEN_TTL_MS=900000
# CITERO_REFRESH_TOKEN_TTL_MS=2592000000

# --- Cookie del refresh token ---
# En producción debe ser true (default). En local por HTTP, false.
CITERO_COOKIE_SECURE=false
# CITERO_COOKIE_NAME=citero_refresh
# CITERO_COOKIE_SAME_SITE=Lax
# CITERO_COOKIE_DOMAIN=.citero.app
# CITERO_COOKIE_PATH=/api/auth

# --- Frontend / CORS ---
CITERO_FRONTEND_URL=http://localhost:3000
CITERO_FRONTEND_DASHBOARD_URL=http://localhost:3000/dashboard
CITERO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Resend (envío de emails) ---
# API key de Resend (https://resend.com/api-keys).
RESEND_API_KEY=
# Dirección verificada en Resend; debe pertenecer al dominio verificado.
CITERO_EMAIL_FROM=noreply@citero.app
# Reintentos de envío ante fallos.
# CITERO_EMAIL_RETRY_MAX_ATTEMPTS=3
# CITERO_EMAIL_RETRY_BACKOFF_MS=1000
# Habilita/deshabilita globalmente el scheduler de recordatorios.
# CITERO_REMINDER_SCHEDULER_ENABLED=true

# --- Cloudinary (subida de imágenes) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=citero

# --- Subida de archivos (multipart) ---
# MULTIPART_MAX_FILE_SIZE=5MB
# MULTIPART_MAX_REQUEST_SIZE=5MB
